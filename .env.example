# ==========================================================
# 🐘 POSTGRES 17 (container) — credenciais do banco
# ==========================================================
POSTGRES_USER=studfy
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=studfy

# ==========================================================
# ⚙️ API
# ==========================================================
# Porta exposta no host para a API (dentro do container é sempre 8080)
API_PORT=8080

# true = roda o AutoMigrate no boot (necessário na primeira vez com banco vazio).
# Depois que as tabelas existirem, pode setar false para ligar mais rápido.
#
# ⚠️ BANCO QUE JÁ TEM DADOS: rode ANTES o script de preparação, senão o
#    AutoMigrate falha ao criar os índices UNIQUE e a API não sobe:
#      psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -f migrations/001_pre_migracao.sql
#    (faça backup antes: pg_dump "$DATABASE_URL" > backup.sql)
AUTO_MIGRATE=true

# release | debug
GIN_MODE=release

# ==========================================================
# 🕐 FUSO HORÁRIO DO PÚBLICO
# ==========================================================
# Servidores em nuvem rodam em UTC. Sem isto, o aluno que estuda às 22h no
# Brasil tem o registro contado no DIA SEGUINTE: a ofensiva quebra sem motivo,
# o log diário vai para a data errada e os relatórios por dia ficam deslocados.
TZ_APP=America/Sao_Paulo

# ==========================================================
# 🔐 AUTENTICAÇÃO — quem faz login é o KEYCLOAK
# ==========================================================
# KEYCLOAK_ONLY controla o ESPELHO do usuário na tabela `users` (não o login).
# Precisa ficar false: XP, ofensiva, plano, bio e tema não existem no token,
# só no banco. Com true, o /v1/app/bootstrap responde 404 e o app não abre.
KEYCLOAK_ONLY=false

# Cadastro/login antigos (senha no nosso banco). Desligados: quem cuida disso
# é o Keycloak. As rotas respondem 410 explicando onde é o login de verdade.
# Se um dia precisar reativar numa migração, ligue AS DUAS ao mesmo tempo —
# uma sem a outra cria um login que gera token recusado em todas as rotas.
ENABLE_LEGACY_AUTH=false
ALLOW_LEGACY_JWT=false

# Só é usado pelas rotas antigas acima. Mantenha um valor forte mesmo assim.
JWT_SECRET=troque-por-um-segredo-bem-grande-e-aleatorio

# 💡 Proteção contra força bruta no login agora é responsabilidade do Keycloak:
#    ative "Brute Force Detection" em Realm Settings → Security Defenses.

# URL do front-end (usada em CORS e nos links de e-mail)
FRONTEND_URL=http://localhost:3000

# ==========================================================
# 🔑 KEYCLOAK — admin do container e portas
# ==========================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque-esta-senha
KEYCLOAK_PORT=8080

# ==========================================================
# 🌐 LOGIN COM GOOGLE (obrigatório para /v1/auth/google)
# É o "Client ID" do OAuth do Google. Sem ele, o login Google é recusado.
# ==========================================================
GOOGLE_CLIENT_ID=

# ==========================================================
# 🚦 RATE LIMIT (por IP) e 🐘 POOL DO BANCO — opcionais, têm padrão seguro
# ==========================================================
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=20
# DB_MAX_OPEN_CONNS=50
# DB_MAX_IDLE_CONNS=15

# ==========================================================
# ✉️ E-MAIL (Brevo) — usado para verificação/reset de senha
# ==========================================================
BREVO_API_KEY=
SENDER_EMAIL=nao-responder@seudominio.com

# ==========================================================
# ℹ️ NOTA: DATABASE_URL NÃO é definida aqui.
# O docker-compose monta a DATABASE_URL automaticamente apontando
# para o serviço "db" a partir de POSTGRES_USER/PASSWORD/DB acima.
# ==========================================================
